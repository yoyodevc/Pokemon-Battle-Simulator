# Copy to .env and fill these in to enable verified account sign-in.
# Only public Supabase credentials belong here. Never use a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
LEAGUE_PORT=3001
LEAGUE_DATABASE=.league/league.sqlite
LEAGUE_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
