# Copy to .env for local use. Configure these separately in Netlify for deployment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this with VITE_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
LEAGUE_PORT=3001
LEAGUE_DATABASE=.league/league.sqlite
LEAGUE_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
