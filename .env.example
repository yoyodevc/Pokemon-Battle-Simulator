# Copy to .env for local use. Configure these separately in Netlify for deployment.
LEAGUE_PORT=3001
LEAGUE_DATABASE=.league/league.sqlite
LEAGUE_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Public web config from Firebase Console > Project settings > General > Your apps.
# Safe to expose to the browser (served back out through /api/league/config).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server only. A service-account key from Firebase Console > Project settings >
# Service accounts > Generate new private key. Never prefix with VITE_ or expose to the
# browser. Use ONE of these two:
#   FIREBASE_SERVICE_ACCOUNT_PATH: a local file path (convenient for local development).
#   FIREBASE_SERVICE_ACCOUNT: the key's raw JSON contents (what Netlify env vars need).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=
